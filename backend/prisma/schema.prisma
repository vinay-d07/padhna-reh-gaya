generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityType {
  WORKSPACE_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  CHAT_STARTED
  MESSAGE_SENT
  NOTE_CREATED
  NOTE_UPDATED
  SUMMARY_GENERATED
  FLASHCARDS_GENERATED
  FLASHCARD_REVIEWED
  QUIZ_GENERATED
  QUIZ_COMPLETED
  ROOM_JOINED
  ROOM_LEFT
  STUDY_SESSION_STARTED
  STUDY_SESSION_ENDED
}

///////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////

model User {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  clerkId String @unique

  email String @unique

  name String?

  imageUrl String?

  lastSeen DateTime?

  preferences Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspaces Workspace[] @relation("WorkspaceOwner")

  memberships WorkspaceMember[]

  uploadedDocuments Document[] @relation("UploadedDocuments")

  conversations Conversation[]

  notes Note[]

  activities Activity[]

  flashcardProgress FlashcardProgress[]

  createdRooms StudyRoom[] @relation("RoomCreator")

  roomParticipations RoomParticipant[]

  studySessions StudySession[]

  roomMessages RoomMessage[]
}

///////////////////////////////////////////////////////////
// WORKSPACE
///////////////////////////////////////////////////////////

model Workspace {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String

  description String?

  icon String?

  color String?

  coverImage String?

  ownerId String @db.ObjectId

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members WorkspaceMember[]

  documents Document[]

  conversations Conversation[]

  notes Note[]

  activities Activity[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([ownerId])
}

///////////////////////////////////////////////////////////
// WORKSPACE MEMBERS
///////////////////////////////////////////////////////////

model WorkspaceMember {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  role WorkspaceRole @default(EDITOR)

  joinedAt DateTime @default(now())

  @@unique([workspaceId,userId])
}

///////////////////////////////////////////////////////////
// DOCUMENT
///////////////////////////////////////////////////////////

model Document {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  uploadedById String @db.ObjectId

  uploadedBy User @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  title String

  fileName String

  storageKey String

  mimeType String

  fileSize Int

  pageCount Int?

  language String?

  author String?

  thumbnailUrl String?

  vectorNamespace String

  status DocumentStatus @default(PROCESSING)

  // Coarse ingestion progress (0-100), updated by the ingestion worker as a
  // job moves through download -> parse/embed -> finalize. Only meaningful
  // while status is PROCESSING.
  ingestProgress Int @default(0)

  errorMessage String?

  summary Summary?

  flashcards Flashcard[]

  quiz Quiz?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([workspaceId,status])
}

///////////////////////////////////////////////////////////
// SUMMARY
///////////////////////////////////////////////////////////

model Summary {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  documentId String @unique @db.ObjectId

  document Document @relation(fields: [documentId], references: [id])

  content String

  model String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////
// FLASHCARD
///////////////////////////////////////////////////////////

model Flashcard {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  documentId String @db.ObjectId

  document Document @relation(fields: [documentId], references: [id])

  question String

  answer String

  order Int @default(0)

  createdAt DateTime @default(now())

  progress FlashcardProgress[]

  @@index([documentId])
}

///////////////////////////////////////////////////////////
// FLASHCARD PROGRESS (per-user SM-2 spaced-repetition state)
///////////////////////////////////////////////////////////

model FlashcardProgress {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  flashcardId String @db.ObjectId

  flashcard Flashcard @relation(fields: [flashcardId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  // SM-2 state — see backend/src/lib/spacedRepetition.js
  easeFactor Float @default(2.5)

  intervalDays Int @default(0)

  repetitions Int @default(0)

  dueDate DateTime @default(now())

  lastReviewedAt DateTime?

  @@unique([flashcardId,userId])

  @@index([userId,dueDate])
}

///////////////////////////////////////////////////////////
// QUIZ
///////////////////////////////////////////////////////////

model Quiz {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  documentId String @unique @db.ObjectId

  document Document @relation(fields: [documentId], references: [id])

  // [{ question, options: [4 strings], correctIndex, explanation }]
  questions Json

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////
// CONVERSATION
///////////////////////////////////////////////////////////

model Conversation {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  title String?

  isGeneratedTitle Boolean @default(false)

  lastMessageAt DateTime?

  messages Message[]

  notes Note[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([userId])

  @@index([workspaceId,lastMessageAt])
}

///////////////////////////////////////////////////////////
// MESSAGE
///////////////////////////////////////////////////////////

model Message {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String @db.ObjectId

  conversation Conversation @relation(fields: [conversationId], references: [id])

  role MessageRole

  content String

  sources Json?

  modelUsed String?

  tokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId])

  @@index([conversationId,createdAt])
}

///////////////////////////////////////////////////////////
// NOTES
///////////////////////////////////////////////////////////

model Note {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  conversationId String? @db.ObjectId

  conversation Conversation? @relation(fields: [conversationId], references: [id])

  title String

  content Json

  plainText String?

  wordCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([userId])

  @@index([conversationId])

  @@index([workspaceId,updatedAt])
}

///////////////////////////////////////////////////////////
// ACTIVITY
///////////////////////////////////////////////////////////

model Activity {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  workspaceId String? @db.ObjectId

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  type ActivityType

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([workspaceId])

  @@index([type])

  @@index([createdAt])
}

///////////////////////////////////////////////////////////
// STUDY ROOMS (global, cross-workspace co-working rooms)
///////////////////////////////////////////////////////////

model StudyRoom {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String

  description String?

  createdById String @db.ObjectId

  createdBy User @relation("RoomCreator", fields: [createdById], references: [id])

  isPrivate Boolean @default(false)

  // Only set (and only ever returned to the creator / a member) when
  // isPrivate — a short code required to join otherwise. Not globally
  // unique: it's only ever checked against *this* room's code, so a
  // collision with another room's code is meaningless.
  joinCode String?

  participants RoomParticipant[]

  sessions StudySession[]

  messages RoomMessage[]

  createdAt DateTime @default(now())

  deletedAt DateTime?

  @@index([deletedAt])
}

model RoomParticipant {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  roomId String @db.ObjectId

  room StudyRoom @relation(fields: [roomId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  // null = currently present in the room
  leftAt DateTime?

  // "What are you studying?" — asked on entry, shown next to the avatar.
  topic String?

  @@unique([roomId,userId])

  @@index([roomId,leftAt])
}

///////////////////////////////////////////////////////////
// ROOM MESSAGE (simple group chat, scoped to a room)
///////////////////////////////////////////////////////////

model RoomMessage {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  roomId String @db.ObjectId

  room StudyRoom @relation(fields: [roomId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  content String

  // Emoji reactions, e.g. { "🔥": ["userId1", "userId2"], "👏": ["userId3"] }.
  // Kept as a loose Json map (rather than a separate model) since it's small,
  // never queried by content, and always read/written whole.
  reactions Json?

  createdAt DateTime @default(now())

  @@index([roomId,createdAt])
}

///////////////////////////////////////////////////////////
// STUDY SESSION (the "Start Studying" timer — roomId is optional so a
// session can stand alone, outside any room)
///////////////////////////////////////////////////////////

model StudySession {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  roomId String? @db.ObjectId

  room StudyRoom? @relation(fields: [roomId], references: [id])

  startedAt DateTime @default(now())

  // null = still active
  endedAt DateTime?

  durationSeconds Int?

  createdAt DateTime @default(now())

  @@index([userId,endedAt])

  @@index([roomId,endedAt])
}