generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityType {
  WORKSPACE_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  CHAT_STARTED
  MESSAGE_SENT
  NOTE_CREATED
  NOTE_UPDATED
  SUMMARY_GENERATED
  FLASHCARDS_GENERATED
}

///////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////

model User {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  clerkId String @unique

  email String @unique

  name String?

  imageUrl String?

  lastSeen DateTime?

  preferences Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  workspaces Workspace[] @relation("WorkspaceOwner")

  memberships WorkspaceMember[]

  uploadedDocuments Document[] @relation("UploadedDocuments")

  conversations Conversation[]

  notes Note[]

  activities Activity[]
}

///////////////////////////////////////////////////////////
// WORKSPACE
///////////////////////////////////////////////////////////

model Workspace {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String

  description String?

  icon String?

  color String?

  coverImage String?

  ownerId String @db.ObjectId

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members WorkspaceMember[]

  documents Document[]

  conversations Conversation[]

  notes Note[]

  activities Activity[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([ownerId])
}

///////////////////////////////////////////////////////////
// WORKSPACE MEMBERS
///////////////////////////////////////////////////////////

model WorkspaceMember {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  role WorkspaceRole @default(EDITOR)

  joinedAt DateTime @default(now())

  @@unique([workspaceId,userId])
}

///////////////////////////////////////////////////////////
// DOCUMENT
///////////////////////////////////////////////////////////

model Document {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  uploadedById String @db.ObjectId

  uploadedBy User @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  title String

  fileName String

  storageKey String

  mimeType String

  fileSize Int

  pageCount Int?

  language String?

  author String?

  thumbnailUrl String?

  vectorNamespace String

  status DocumentStatus @default(PROCESSING)

  errorMessage String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([workspaceId,status])
}

///////////////////////////////////////////////////////////
// CONVERSATION
///////////////////////////////////////////////////////////

model Conversation {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  title String?

  isGeneratedTitle Boolean @default(false)

  lastMessageAt DateTime?

  messages Message[]

  notes Note[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([userId])

  @@index([workspaceId,lastMessageAt])
}

///////////////////////////////////////////////////////////
// MESSAGE
///////////////////////////////////////////////////////////

model Message {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String @db.ObjectId

  conversation Conversation @relation(fields: [conversationId], references: [id])

  role MessageRole

  content String

  sources Json?

  modelUsed String?

  tokens Int?

  createdAt DateTime @default(now())

  @@index([conversationId])

  @@index([conversationId,createdAt])
}

///////////////////////////////////////////////////////////
// NOTES
///////////////////////////////////////////////////////////

model Note {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String @db.ObjectId

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  conversationId String? @db.ObjectId

  conversation Conversation? @relation(fields: [conversationId], references: [id])

  title String

  content Json

  plainText String?

  wordCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([workspaceId])

  @@index([userId])

  @@index([conversationId])

  @@index([workspaceId,updatedAt])
}

///////////////////////////////////////////////////////////
// ACTIVITY
///////////////////////////////////////////////////////////

model Activity {

  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  user User @relation(fields: [userId], references: [id])

  workspaceId String? @db.ObjectId

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  type ActivityType

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])

  @@index([workspaceId])

  @@index([type])

  @@index([createdAt])
}